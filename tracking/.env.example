# Copiez ce fichier en .env pour lancer en local (le fichier .env n'est jamais commité).
# En production, ces valeurs vont dans GitHub > Settings > Secrets and variables > Actions.

# --- Base (vide = SQLite locale dans data/tracking.db) ---
DATABASE_URL=

# --- Google : un seul compte de service pour GA4, Search Console et Agenda ---
GOOGLE_SERVICE_ACCOUNT_JSON=          # contenu JSON du compte de service, ou chemin vers le fichier
GA4_PROPERTY_ID=                      # ex. 412345678
GA4_SIGNUP_EVENT=sign_up              # événement GA4 déclenché à l'inscription
SEARCH_CONSOLE_SITE=sc-domain:flugia.com
BRAND_TERMS=flugia
GOOGLE_CALENDAR_ID=                   # ID de l'agenda des démos (partagé avec le compte de service)
DEMO_KEYWORDS=démo,demo               # mots du titre qui identifient un rendez-vous de démo

# --- Google Ads ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=               # ex. 123-456-7890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=         # si compte administrateur (MCC)

# --- Meta ---
META_ACCESS_TOKEN=                    # jeton d'utilisateur système (n'expire pas)
META_AD_ACCOUNT_ID=                   # sans "act_"
META_IG_USER_ID=                      # compte Instagram professionnel
META_PAGE_ID=                         # page Facebook (statistiques organiques)

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=                # expire après 60 jours : le tableau de bord le signalera
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_ORGANIZATION_ID=

# --- IA (mesure GEO hebdomadaire + synthèse du lundi) ---
ANTHROPIC_API_KEY=
GEO_RUN_WEEKDAY=0                     # 0 = lundi ; * = tous les jours

# --- Plus tard ---
APP_DATABASE_URL=                     # postgresql://lecture_seule:...@hote/base
STRIPE_API_KEY=                       # clé restreinte en lecture seule

# --- Notifications ---
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=                      # xoxb-… : nécessaire pour joindre le rapport PDF
SLACK_CHANNEL_ID=                     # ex. C0123456789 (canal où publier)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
DASHBOARD_URL=
